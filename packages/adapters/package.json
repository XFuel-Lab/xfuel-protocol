{
  "name": "@xfuel/adapters",
  "version": "0.1.0",
  "description": "Chit402 framework adapters — LangChain and Vercel AI SDK helpers with verify_url extraction.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js"
    },
    "./receipt": {
      "types": "./dist/receipt.d.ts",
      "import": "./dist/receipt.js"
    },
    "./ingest": {
      "types": "./dist/ingest.d.ts",
      "import": "./dist/ingest.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "chit402",
    "langchain",
    "ai-sdk",
    "vercel",
    "openai",
    "agents",
    "usdc",
    "x402",
    "receipts",
    "verify_url"
  ],
  "author": "XFuel Lab",
  "license": "Apache-2.0",
  "homepage": "https://chit402.com/docs/framework-adapters",
  "bugs": {
    "url": "https://github.com/XFuel-Lab/chit402/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/XFuel-Lab/chit402.git",
    "directory": "packages/adapters"
  },
  "peerDependencies": {
    "@ai-sdk/openai": "^1.0.0 || ^2.0.0",
    "@langchain/openai": "^0.3.0 || ^0.4.0 || ^0.5.0 || ^0.6.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    },
    "@langchain/openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai": "^1.3.0",
    "@langchain/openai": "^0.6.0",
    "@types/node": "^20.17.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
