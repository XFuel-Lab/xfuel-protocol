    },
    "./ingest": {
      "types": "./ingest.d.ts",
      "import": "./ingest.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "langchain.js",
    "langchain.d.ts",
    "ai-sdk.js",
    "ai-sdk.d.ts",
    "receipt.js",
    "receipt.d.ts",
    "ingest.js",
